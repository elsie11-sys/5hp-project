}

@keyframes time-glow-pulse {
  0%, 100% { text-shadow: 0 0 12px rgba(0, 195, 255, 0.8), 0 0 24px rgba(0, 195, 255, 0.4); }
  50% { text-shadow: 0 0 16px rgba(0, 195, 255, 1), 0 0 32px rgba(0, 195, 255, 0.6); }
}

.dashboard-tabs {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 4px 20px;
  flex-shrink: 0;
}

.tech-tab {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 18px;
  background: var(--bg-soft);
  border: 1px solid var(--border-soft);
  border-radius: 20px;
  color: var(--text-dim);
  font-size: 13px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.3s;
  overflow: hidden;
}

.tech-tab:hover {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: var(--border);
}

.tech-tab-icon { font-size: 14px; }

.tech-tab.active {
  background: var(--grad-main);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 0 24px rgba(0, 195, 255, 0.5), 0 0 40px rgba(255, 149, 0, 0.3);
  text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
}

.tech-tab.active::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--primary), var(--secondary), var(--primary), transparent);
  background-size: 200% 100%;
  animation: tab-border-move 3s linear infinite;
}

.tech-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--primary), var(--secondary), var(--primary), transparent);
  background-size: 200% 100%;
  animation: tab-border-move 3s linear infinite;
  animation-delay: -1.5s;
}

@keyframes tab-border-move {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.tech-tab-glow {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 60%;
  height: 1px;
  background: var(--primary);
  transform: translateX(-50%);
  opacity: 0;
  transition: opacity 0.3s;
}

.tech-tab.active .tech-tab-glow {
  opacity: 1;
  box-shadow: 0 0 10px var(--primary);
}

.tech-tab-label { font-size: 13px; }

.dashboard-body {
  position: relative;
  z-index: 3;
  flex: 1;
  display: grid;
  grid-template-columns: 24% 1fr 24%;
  gap: 8px;
  padding: 4px 16px 12px;
  min-height: 0;
  height: 0;
}

.left-col, .right-col, .center-col {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 0;
  height: 100%;
}

.center-col { gap: 6px; }

.tech-panel {
  position: relative;
  flex: 1;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 195, 255, 0.06), inset 0 0 20px rgba(0, 195, 255, 0.02);
  min-height: 0;
  overflow: hidden;
  transition: box-shadow 0.3s, transform 0.3s;
}

.tech-panel:hover {
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(0, 195, 255, 0.1), inset 0 0 20px rgba(0, 195, 255, 0.03), 0 0 24px rgba(0, 195, 255, 0.08);
}

.tech-panel::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, #00c3ff, transparent 30%, transparent 70%, #ff9500);
  background-size: 200% 100%;
  border-radius: 4px 4px 0 0;
  animation: border-shine 4s linear infinite;
}

@keyframes border-shine {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.tech-panel::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 16px;
  height: 16px;
  border-top: 2px solid #00c3ff;
  border-left: 2px solid #00c3ff;
  border-radius: 4px 0 0 0;
  box-shadow: 0 0 12px rgba(0, 195, 255, 0.8);
  animation: corner-pulse 2s ease-in-out infinite;
}

@keyframes corner-pulse {
  0%, 100% { box-shadow: 0 0 10px rgba(0, 195, 255, 0.7); }
  50% { box-shadow: 0 0 16px rgba(0, 195, 255, 1); }
}

.panel-corner {
  position: absolute;
  width: 16px;
  height: 16px;
  pointer-events: none;
}

.panel-corner.br { bottom: 0; right: 0; }

.panel-corner.br::before {
  content: '';
  position: absolute;
  bottom: 0;
  right: 0;
  width: 16px;
  height: 16px;
  border-bottom: 2px solid #00c3ff;
  border-right: 2px solid #00c3ff;
  border-radius: 0 0 4px 0;
  box-shadow: 0 0 12px rgba(0, 195, 255, 0.8);
  animation: corner-pulse 2s ease-in-out infinite;
}

.tech-panel-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
  position: relative;
  flex-shrink: 0;
}

.panel-bullet {
  width: 10px;
  height: 10px;
  background: var(--grad-main);
  border-radius: 2px;
  box-shadow: 0 0 12px rgba(0, 195, 255, 0.8);
  animation: bullet-pulse 2s ease-in-out infinite;
}

@keyframes bullet-pulse {
  0%, 100% { box-shadow: 0 0 10px rgba(0, 195, 255, 0.7); }
  50% { box-shadow: 0 0 14px rgba(0, 195, 255, 1); }
}

.panel-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1px;
  position: relative;
  padding-bottom: 4px;
}

.panel-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, #00c3ff 0%, #ff9500 50%, transparent 100%);
  background-size: 200% 100%;
  animation: panel-title-line 3s linear infinite;
  opacity: 0.7;
}

@keyframes panel-title-line {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.panel-subtitle {
  margin-left: auto;
  font-size: 10px;
  padding: 2px 8px;
  background: var(--primary-soft);
  border: 1px solid var(--border-soft);
  color: var(--primary);
  border-radius: 3px;
  letter-spacing: 0.5px;
}

.tech-panel-body {
  flex: 1;
  min-height: 0;
  position: relative;
}

.filter-bar {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.filter-item label {
  font-size: 12px;
  color: var(--text-dim);
}

.select-box {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.select-box select {
  appearance: none;
  -webkit-appearance: none;
  background: linear-gradient(135deg, rgba(0, 195, 255, 0.06), rgba(6, 14, 32, 0.5));
  border: 1px solid var(--border-soft);
  border-radius: 4px;
  color: var(--text);
  font-size: 12px;
  padding: 4px 20px 4px 8px;
  font-family: inherit;
  cursor: pointer;
  outline: none;
  transition: all 0.3s;
}

.select-box select:hover,
.select-box select:focus {
  border-color: #00c3ff;
  box-shadow: 0 0 8px rgba(0, 195, 255, 0.2);
}

.arrow-down {
  position: absolute;
  right: 6px;
  top: 50%;
  transform: translateY(-50%);
  color: #00c3ff;
  font-size: 8px;
  pointer-events: none;
}

.btn-group { display: flex; gap: 6px; margin-left: auto; }

.btn-search, .btn-reset {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  border: 1px solid var(--border-soft);
  border-radius: 4px;
  background: linear-gradient(135deg, rgba(0, 195, 255, 0.05), rgba(6, 14, 32, 0.5));
  color: var(--text-dim);
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.3s;
}

.btn-search:hover, .btn-reset:hover {
  border-color: #00c3ff;
  color: #00c3ff;
  box-shadow: 0 0 10px rgba(0, 195, 255, 0.2);
}

.btn-search {
  background: var(--grad-main);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 0 12px rgba(0, 195, 255, 0.4);
}

.btn-search:hover { filter: brightness(1.1); }
.btn-search .icon, .btn-reset .icon { font-size: 12px; }

.kpi-icons-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  margin-bottom: 10px;
}

.kpi-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px 4px;
  background: linear-gradient(135deg, rgba(0, 195, 255, 0.05), rgba(6, 14, 32, 0.5));
  border: 1px solid var(--border-soft);
  border-radius: 4px;
  transition: all 0.3s;
}

.kpi-icon-item:hover {
  border-color: var(--border);
  transform: translateY(-2px);
}

.kpi-icon {
  font-size: 20px;
  filter: drop-shadow(0 0 8px rgba(0, 195, 255, 0.5));
}

.kpi-icon-1 { filter: drop-shadow(0 0 8px rgba(0, 195, 255, 0.7)); }
.kpi-icon-2 { filter: drop-shadow(0 0 8px rgba(255, 149, 0, 0.7)); }
.kpi-icon-3 { filter: drop-shadow(0 0 8px rgba(0, 255, 163, 0.7)); }
.kpi-icon-4 { filter: drop-shadow(0 0 8px rgba(255, 71, 87, 0.7)); }

.kpi-icon-label {
  font-size: 10px;
  color: var(--text-dim);
  text-align: center;
}

.kpi-main-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.kpi-main-card {
  position: relative;
  background: linear-gradient(135deg, rgba(0, 195, 255, 0.08) 0%, rgba(6, 14, 32, 0.6) 100%);
  border: 1px solid var(--border-soft);
  border-radius: 4px;
  padding: 10px 12px;
  overflow: hidden;
  transition: all 0.3s;
}

.kpi-main-card:hover {
  border-color: var(--border);
  box-shadow: 0 4px 20px rgba(0, 195, 255, 0.15);
}

.kmc-deco {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
}

.kmc-1 .kmc-deco { border-width: 0 36px 36px 0; border-color: transparent #00c3ff transparent transparent; filter: drop-shadow(0 0 6px rgba(0, 195, 255, 0.6)); }
.kmc-2 .kmc-deco { border-width: 0 36px 36px 0; border-color: transparent #ff9500 transparent transparent; filter: drop-shadow(0 0 6px rgba(255, 149, 0, 0.6)); }
.kmc-3 .kmc-deco { border-width: 0 36px 36px 0; border-color: transparent #00ffa3 transparent transparent; filter: drop-shadow(0 0 6px rgba(0, 255, 163, 0.6)); }
.kmc-4 .kmc-deco { border-width: 0 36px 36px 0; border-color: transparent #ff4757 transparent transparent; filter: drop-shadow(0 0 6px rgba(255, 71, 87, 0.6)); }

.kmc-label {
  font-size: 11px;
  color: var(--text-dim);
  margin-bottom: 6px;
}

.kmc-value {
  font-size: 22px;
  font-weight: 700;
  font-family: 'Consolas', 'Monaco', monospace;
  letter-spacing: 2px;
  margin-bottom: 4px;
}

.kmc-value .num {
  color: #00c3ff;
  text-shadow: 0 0 14px rgba(0, 195, 255, 0.8), 0 0 28px rgba(0, 195, 255, 0.4);
}

.kmc-2 .kmc-value .num {
  color: #ff9500;
  text-shadow: 0 0 14px rgba(255, 149, 0, 0.8), 0 0 28px rgba(255, 149, 0, 0.4);
}

.kmc-3 .kmc-value .num {
  color: #00ffa3;
  text-shadow: 0 0 14px rgba(0, 255, 163, 0.8), 0 0 28px rgba(0, 255, 163, 0.4);
}

.kmc-4 .kmc-value .num {
  color: #ff4757;
  text-shadow: 0 0 14px rgba(255, 71, 87, 0.8), 0 0 28px rgba(255, 71, 87, 0.4);
}

.kmc-value .unit {
  font-size: 13px;
  color: var(--text-dim);
  margin-left: 4px;
  font-weight: 400;
}

.kmc-trend {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
}

.kmc-trend.up { color: var(--success); }
.kmc-trend.down { color: var(--text-dim); }
.kmc-trend .trend-arrow { font-weight: 700; }

.kmc-bar {
  margin-top: 6px;
  height: 4px;
  background: var(--border-soft);
  border-radius: 2px;
  overflow: hidden;
}

.kmc-bar-fill {
  height: 100%;
  transition: width 0.8s ease-out;
}

.kmc-3 .kmc-bar-fill {
  background: linear-gradient(90deg, #00c3ff, #0080aa);
  box-shadow: 0 0 8px rgba(0, 195, 255, 0.6);
}

.kmc-4 .kmc-bar-fill {
  background: linear-gradient(90deg, #ff9500, #ff6b00);
  box-shadow: 0 0 8px rgba(255, 149, 0, 0.6);
}

.chart-area {
  width: 100%;
  height: 100%;
  min-height: 0;
  position: relative;
  border-radius: 4px;
  background: radial-gradient(ellipse at center, rgba(0, 195, 255, 0.02) 0%, transparent 70%);
  box-shadow: inset 0 0 20px rgba(0, 195, 255, 0.02);
}

.chart-area::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0, 195, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 195, 255, 0.02) 1px, transparent 1px);
  background-size: 30px 30px;
  border-radius: 4px;
  pointer-events: none;
  opacity: 0.5;
}

.stage-stats {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 10px;
}

.stage-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 10px;
  background: linear-gradient(135deg, rgba(0, 195, 255, 0.04), rgba(6, 14, 32, 0.5));
  border: 1px solid var(--border-soft);
  border-radius: 4px;
}

.stage-value {
  font-size: 18px;
  font-weight: 700;
  color: #00c3ff;
  font-family: 'Consolas', 'Monaco', monospace;
  text-shadow: 0 0 12px rgba(0, 195, 255, 0.7);
}

.stage-item:nth-child(2) .stage-value {
  color: #ff9500;
  text-shadow: 0 0 12px rgba(255, 149, 0, 0.7);
}

.stage-item:nth-child(3) .stage-value {
  color: #00ffa3;
  text-shadow: 0 0 12px rgba(0, 255, 163, 0.7);
}

.stage-label {
  font-size: 11px;
  color: var(--text-dim);
}

.stage-bar {
  height: 4px;
  background: var(--border-soft);
  border-radius: 2px;
  overflow: hidden;
}

.stage-bar-fill {
  height: 100%;
  transition: width 0.8s ease-out;
}

.stage-item:nth-child(1) .stage-bar-fill {
  background: linear-gradient(90deg, #00c3ff, #0080aa);
  box-shadow: 0 0 8px rgba(0, 195, 255, 0.6);
}

.stage-item:nth-child(2) .stage-bar-fill {
  background: linear-gradient(90deg, #ff9500, #ff6b00);
  box-shadow: 0 0 8px rgba(255, 149, 0, 0.6);
}

.stage-item:nth-child(3) .stage-bar-fill {
  background: linear-gradient(90deg, #00ffa3, #00cc82);
  box-shadow: 0 0 8px rgba(0, 255, 163, 0.6);
}

.gauge-row {
  display: flex;
  gap: 8px;
  height: 100%;
  min-height: 120px;
}

.gauge-item {
  flex: 1;
  min-height: 0;
  background: linear-gradient(135deg, rgba(0, 195, 255, 0.03), rgba(6, 14, 32, 0.5));
  border-radius: 4px;
  padding: 8px;
  position: relative;
}

.gauge-item::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 4px;
  background: linear-gradient(180deg, rgba(0, 195, 255, 0.04), transparent);
  pointer-events: none;
}

.map-panel {
  flex: 1;
}

.map-panel-header {
  flex-wrap: wrap;
}

.map-info-strip {
  display: flex;
  gap: 12px;
  font-size: 11px;
  color: var(--text-dim);
  margin-left: auto;
}

.map-info-strip b {
  color: #00c3ff;
  font-weight: 600;
  font-family: 'Consolas', monospace;
}

.map-area {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 0;
  flex: 1;
  background:
    radial-gradient(ellipse at center, rgba(0, 195, 255, 0.03) 0%, transparent 70%),
    linear-gradient(135deg, var(--bg-card), var(--bg-deep));
  border: 1px solid var(--border);
  border-radius: 4px;
  overflow: hidden;
  box-shadow: 0 0 40px rgba(0, 195, 255, 0.1), inset 0 0 40px rgba(0, 195, 255, 0.02);
  animation: map-glow-breathe 5s ease-in-out infinite;
}

@keyframes map-glow-breathe {
  0%, 100% { box-shadow: 0 0 40px rgba(0, 195, 255, 0.1), inset 0 0 40px rgba(0, 195, 255, 0.02); }
  50% { box-shadow: 0 0 60px rgba(0, 195, 255, 0.2), inset 0 0 60px rgba(0, 195, 255, 0.04); }
}

.map-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.map-loading {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  z-index: 5;
}

.map-radar {
  width: 100px;
  height: 100px;
  border: 2px solid #00c3ff;
  border-radius: 50%;
  position: relative;
  animation: radar-rotate 3s linear infinite;
  box-shadow: 0 0 30px rgba(0, 195, 255, 0.5);
}

.map-radar::before {
  content: '';
  position: absolute;
  inset: -10px;
  border: 1px solid #00c3ff;
  border-radius: 50%;
  opacity: 0.5;
  animation: radar-pulse 2s ease-out infinite;
}

@keyframes radar-rotate {
  0% { transform: rotate(0); }
  100% { transform: rotate(360deg); }
}

@keyframes radar-pulse {
  0% { transform: scale(0.8); opacity: 0.9; }
  100% { transform: scale(1.4); opacity: 0; }
}

.map-loading-text {
  font-size: 13px;
  color: #00c3ff;
  letter-spacing: 2px;
  text-shadow: 0 0 12px rgba(0, 195, 255, 0.8);
}

.map-deco {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.8s ease-out;
}

.map-deco-ready { opacity: 1; }

.map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0, 195, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 195, 255, 0.03) 1px, transparent 1px);
  background-size: 50px 50px;
}

.map-corner {
  position: absolute;
  width: 24px;
  height: 24px;
}

.map-corner::before,
.map-corner::after {
  content: '';
  position: absolute;
  background: #00c3ff;
  box-shadow: 0 0 10px rgba(0, 195, 255, 0.8);
}

.mc-tl { top: 8px; left: 8px; }
.mc-tl::before { top: 0; left: 0; width: 20px; height: 2px; }
.mc-tl::after { top: 0; left: 0; width: 2px; height: 20px; }

.mc-tr { top: 8px; right: 8px; }
.mc-tr::before { top: 0; right: 0; width: 20px; height: 2px; }
.mc-tr::after { top: 0; right: 0; width: 2px; height: 20px; }

.mc-bl { bottom: 8px; left: 8px; }
.mc-bl::before { bottom: 0; left: 0; width: 20px; height: 2px; }
.mc-bl::after { bottom: 0; left: 0; width: 2px; height: 20px; }

.mc-br { bottom: 8px; right: 8px; }
.mc-br::before { bottom: 0; right: 0; width: 20px; height: 2px; }
.mc-br::after { bottom: 0; right: 0; width: 2px; height: 20px; }

.map-back-btn {
  position: absolute;
  left: 12px;
  bottom: 12px;
  z-index: 10;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--text);
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.3s;
  backdrop-filter: blur(8px);
}

.map-back-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: 0 0 12px rgba(0, 195, 255, 0.3);
  transform: translateX(-2px);
}

.back-icon {
  font-size: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
}

.map-legend {
  position: absolute;
  bottom: 12px;
  left: 12px;
  z-index: 10;
  padding: 12px 14px;
  background: linear-gradient(180deg, rgba(6, 14, 32, 0.95) 0%, rgba(4, 10, 20, 0.92) 100%);
  border: 1px solid rgba(0, 195, 255, 0.5);
  border-radius: 4px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 195, 255, 0.15);
  backdrop-filter: blur(8px);
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 180px;
}

.map-legend::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
