        { name: '高中' + currentMetric.value.name + '率', value: d.senior, itemStyle: { color: '#55ccff' } },
      ],
      emphasis: { scale: true, scaleSize: 4 },
      animationType: 'expansion', animationDuration: 1000,
    }],
  };
};

const getIndustryBarOption = () => {
  const c = getColors();
  const seed = parseInt(routeCode.value.slice(-2), 10) || 13;
  const industries = ['智能农业', '媒体体育', '系统集成', '数字医疗', '在线教育', '文化传媒', '电商平台'];
  const values = industries.map((_, i) => Math.round(50 + ((seed + i * 13) % 50)));
  return {
    backgroundColor: 'transparent',
    tooltip: { ...getTooltip('axis'), formatter: (params) => `${params[0].name}<br/>占比: <b>${params[0].value}%</b>` },
    grid: { left: 65, right: 30, top: 10, bottom: 10 },
    xAxis: { type: 'value', show: false, max: 100 },
    yAxis: {
      type: 'category', data: industries.slice().reverse(),
      axisLine: { show: false }, axisTick: { show: false },
      axisLabel: { color: c.text, fontSize: 10, fontWeight: 500 }
    },
    series: [{
      type: 'bar', data: values.slice().reverse(),
      barWidth: 10,
      itemStyle: {
        borderRadius: [0, 5, 5, 0],
        color: (p) => {
          const colors = ['#00c3ff', '#ff9500', '#55ccff', '#ff6b6b', '#a855f7', '#34d399', '#fbbf24'];
          return colors[p.dataIndex % colors.length];
        }
      },
      label: { show: true, position: 'right', color: c.textDim, fontSize: 10, formatter: '{c}%' },
      animationDuration: 1200, animationEasing: 'cubicOut',
    }],
  };
};

const getInterventionOption = () => {
  const c = getColors();
  const months = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
  const seed = parseInt(routeCode.value.slice(-2), 10) || 13;
  const base = currentProvinceData.value.rate;
  const genData = (offset) => months.map((_, i) => Math.round((base - 5 + Math.sin((i + offset) * 0.8) * 10 + (seed % 5)) * 10) / 10);
  const data1 = genData(0);
  const data2 = genData(3);
  return {
    backgroundColor: 'transparent',
    tooltip: { ...getTooltip('axis'), trigger: 'axis' },
    legend: {
      data: ['其他区域', '新增本地'],
      textStyle: { color: c.textDim, fontSize: 10 },
      top: 0, right: 5, itemWidth: 10, itemHeight: 6,
    },
    grid: { left: 30, right: 15, top: 30, bottom: 20 },
    xAxis: {
      type: 'category', data: months, boundaryGap: false,
      axisLine: { lineStyle: { color: c.splitLine } },
      axisLabel: { color: c.textDim, fontSize: 10 },
      axisTick: { show: false },
    },
    yAxis: {
      type: 'value',
      axisLine: { show: false }, axisTick: { show: false },
      splitLine: { lineStyle: { color: c.splitLine } },
      axisLabel: { color: c.textDim, fontSize: 10 },
    },
    series: [
      {
        name: '其他区域', type: 'line', data: data1,
        smooth: true, symbol: 'circle', symbolSize: 6,
        lineStyle: { color: '#00c3ff', width: 2 },
        itemStyle: { color: '#00c3ff' },
        areaStyle: {
          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
            { offset: 0, color: 'rgba(0,195,255,0.35)' },
            { offset: 1, color: 'rgba(0,195,255,0.02)' }
          ])
        },
      },
      {
        name: '新增本地', type: 'line', data: data2,
        smooth: true, symbol: 'circle', symbolSize: 6,
        lineStyle: { color: '#ff9500', width: 2 },
        itemStyle: { color: '#ff9500' },
        areaStyle: {
          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
            { offset: 0, color: 'rgba(255,149,0,0.35)' },
            { offset: 1, color: 'rgba(255,149,0,0.02)' }
          ])
        },
      },
    ],
  };
};

const getRankBarOption = () => {
  const c = getColors();
  const data = rankingListData.value.slice(0, 10);
  const names = data.map(d => d.name);
  const values = data.map(d => d.value);
  const maxV = values.length ? Math.max(...values) : 100;

  return {
    backgroundColor: 'transparent',
    tooltip: {
      ...getTooltip('axis'),
      axisPointer: { type: 'shadow' },
      formatter: (params) => {
        const p = params[0];
        return `<div style="font-weight:600;margin-bottom:4px">${names[p.dataIndex]}</div>
                <div>${currentMetric.value.name}率：<span style="color:${c.primary};font-weight:bold">${p.value}%</span></div>`;
      },
    },
    grid: { left: 70, right: 50, top: 10, bottom: 20 },
    xAxis: {
      type: 'value',
      min: 0,
      max: Math.ceil(maxV * 1.2),
      axisLine: { show: false },
      axisTick: { show: false },
      splitLine: { lineStyle: { color: c.splitLine } },
      axisLabel: { color: c.textDim, fontSize: 10, formatter: (v) => v + '%' },
    },
    yAxis: {
      type: 'category',
      data: names.reverse(),
      axisLine: { show: false },
      axisTick: { show: false },
      axisLabel: { color: c.text, fontSize: 11 },
      inverse: false,
    },
    series: [
      {
        name: currentMetric.value.name + '率',
        type: 'bar',
        data: values.reverse(),
        barWidth: 14,
        itemStyle: {
          borderRadius: [0, 4, 4, 0],
          color: (params) => {
            const value = params.value;
            if (value >= 60) return makeGrad('#ff5252', '#e53935');
            if (value >= 55) return makeGrad('#ffb74d', '#f57c00');
            if (value >= 48) return makeGrad('#66bb6a', '#43a047');
            return makeGrad('#00d4ff', '#0891b2');
          },
          shadowBlur: isLight.value ? 4 : 10,
          shadowColor: (params) => {
            const value = params.value;
            if (value >= 60) return 'rgba(255, 82, 82, 0.4)';
            if (value >= 55) return 'rgba(255, 183, 77, 0.4)';
            if (value >= 48) return 'rgba(102, 187, 106, 0.4)';
            return 'rgba(0, 212, 255, 0.4)';
          },
        },
        label: {
          show: true,
          position: 'right',
          color: c.text,
          fontSize: 11,
          fontWeight: 'bold',
          formatter: '{c}%',
        },
      },
    ],
  };
};

const renderAllCharts = () => {
  disposeAll();
  requestAnimationFrame(() => {
    nextTick(() => {
      initChart(ageGenderChartRef, 'ageGender', getAgeGenderOption());
      initChart(donutChartRef, 'donut', getDonutOption());
      initChart(industryBarRef, 'industry', getIndustryBarOption());
      initChart(interventionChartRef, 'intervention', getInterventionOption());
      if (mapLoaded.value) {
        initChart(mapRef, 'map', getMapOption(), (params) => {
          if (params?.name) drillToCity(params.name);
        });
      }
    });
  });
};

const loadMap = async () => {
  const code = routeCode.value;
  const cfg = currentProvinceConfig.value;
  const urls = [
    `https://geo.datav.aliyun.com/areas_v3/bound/${code}_full.json`,
    `https://fastly.jsdelivr.net/npm/echarts@4.9.0/map/json/province/${cfg.short}.json`,
    `https://geo.datav.aliyun.com/areas_v3/bound/${code}.json`,
  ];
  for (const url of urls) {
    try {
      const res = await fetch(url);
      if (!res.ok) continue;
      const geoJson = await res.json();
      echarts.registerMap('province', geoJson);
      const features = geoJson.features || [];
      if (features.length > 0) {
        const list = [];
        const coords = {};
        features.forEach(f => {
          const props = f.properties || {};
          const fullName = props.name || props.NAME || props.NL_NAME_1 || '';
          if (fullName && fullName.length > 0 && fullName.length < 15) {
            list.push(fullName);
            // 提取城市质心坐标：优先用 centroid，退化为 center，再用 bounding box 中心
            let lng = null, lat = null;
            if (props.centroid && Array.isArray(props.centroid) && props.centroid.length === 2) {
              [lng, lat] = props.centroid;
            } else if (props.center && Array.isArray(props.center) && props.center.length === 2) {
              [lng, lat] = props.center;
            } else if (props.centroid) {
              // 部分数据源 centroid 为字符串
              const m = String(props.centroid).match(/[-]?\d+\.?\d*[, ]+[-]?\d+\.?\d*/);
              if (m) {
                const [a, b] = m[0].split(/[, ]+/).map(Number);
                lng = a; lat = b;
              }
            }
            // 回退：用第一个多边形的中心
            if (lng == null || lat == null) {
              try {
                const c = f.geometry.coordinates;
                const polys = c[0] ? (Array.isArray(c[0][0]) ? c : c[0]) : c;
                let minLng = Infinity, maxLng = -Infinity, minLat = Infinity, maxLat = -Infinity, cnt = 0;
                const rings = Array.isArray(polys[0]?.[0]) ? polys : [polys];
                rings.forEach(ring => {
                  (ring || []).forEach(pt => {
                    if (Array.isArray(pt) && pt.length >= 2) {
                      if (pt[0] < minLng) minLng = pt[0];
                      if (pt[0] > maxLng) maxLng = pt[0];
                      if (pt[1] < minLat) minLat = pt[1];
                      if (pt[1] > maxLat) maxLat = pt[1];
                      cnt++;
                    }
                  });
                });
                if (cnt > 0) {
                  lng = (minLng + maxLng) / 2;
                  lat = (minLat + maxLat) / 2;
                }
              } catch (e) {}
            }
            if (lng != null && lat != null) coords[fullName] = [lng, lat];
          }
        });
        if (list.length >= 3) {
          cityList.value = list.slice(0, 30);
          cityCoords.value = coords;
        } else {
          cityList.value = [];
          cityCoords.value = {};
        }
      } else {
        cityList.value = [];
        cityCoords.value = {};
      }
      mapLoaded.value = true;
      mapZoom.value = cfg.zoom;
      setTimeout(() => renderAllCharts(), 200);
      return;
    } catch (e) {
      console.warn('地图加载失败', url, e);
    }
  }
  cityList.value = [];
  mapLoaded.value = true;
  setTimeout(() => renderAllCharts(), 200);
};

const resizeAll = () => {
  Object.values(chartInstances).forEach(c => { if (c && !c.isDisposed()) c.resize(); });
};

onMounted(() => {
  applySystemTheme();
  observeTheme();
  updateDateTime();
  timer = setInterval(updateDateTime, 1000);
  loadMap();
  renderAllCharts();
  window.addEventListener('resize', resizeAll);
  setTimeout(() => resizeAll(), 500);
  setTimeout(() => resizeAll(), 1500);
});

onBeforeUnmount(() => {
  if (timer) clearInterval(timer);
  window.removeEventListener('resize', resizeAll);
  if (themeObserver) { themeObserver.disconnect(); themeObserver = null; }
  disposeAll();
});

watch(activeTab, () => setTimeout(() => renderAllCharts(), 100));
watch(isLight, () => setTimeout(() => renderAllCharts(), 100));
watch(() => route.query.tab, (tab) => {
  if (tab && typeof tab === 'string' && ['vision','oral','mental','weight','bone'].includes(tab)) {
    activeTab.value = tab;
    setTimeout(() => renderAllCharts(), 100);
  }
}, { immediate: true });
watch(() => route.params.code, () => {
  mapLoaded.value = false;
  cityList.value = [];
  setTimeout(() => loadMap(), 100);
});
</script>
