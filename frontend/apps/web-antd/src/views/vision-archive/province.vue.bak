      z: 100
    }],
    series: [{
      type: 'pie', radius: ['45%', '65%'], center: ['50%', '50%'],
      avoidLabelOverlap: true,
      itemStyle: { borderColor: isLight.value ? '#fff' : 'rgba(6,15,28,0.85)', borderWidth: 2 },
      label: { show: false },
      labelLine: { show: false },
      data: [
        { name: '小学' + currentMetric.value.name + '率', value: d.primary, itemStyle: { color: '#00c3ff' } },
