# ================= 依赖包 =================
# 忽略所有文件夹下的 node_modules (Git 会自动递归查找，前后端的都会被忽略)
node_modules/

# ================= 前端构建产物 =================
# 忽略前端打包生成的文件夹 (通常是 dist 或 build，根据你的前端框架来定)
dist/
build/
.cache/

# ================= 后端运行产物 =================
# 忽略后端的日志文件
logs/
*.log
npm-debug.log*

# ================= 敏感信息与系统文件 =================
# 忽略环境变量文件（里面通常有数据库密码、API密钥，绝对不能上传！）
.env
.env.local
.env.*.local

# 忽略 Mac 和 Windows 系统自动生成的垃圾文件
.DS_Store
Thumbs.db 
